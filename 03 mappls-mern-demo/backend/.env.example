# Backend port
PORT=5000

# Frontend origin (for CORS). The Vite dev server default port is 5173.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local, or started with `docker compose up -d`)
MONGODB_URI=mongodb://127.0.0.1:27017/mappls_demo

# Legacy OAuth credentials (optional); get them at https://auth.mappls.com/console
# In the Console enable Maps SDK, Search (Autosuggest/Geocode/Reverse Geocode) and Routing APIs.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Static key: Map SDK + REST APIs (sent as access_token).
# Optional: separate REST key if your console gave you one.
# MAPPLS_REST_KEY=
MAPPLS_KEY=your_mappls_static_key_here

# ---- Optional: Mappls endpoints override ----
# Default URLs are listed below. If Mappls ever changes a URL you can override it here.
# MAPPLS_AUTOSUGGEST_URL=https://search.mappls.com/search/places/autosuggest/json
# MAPPLS_GEOCODE_URL=https://search.mappls.com/search/address/geocode
# MAPPLS_REVERSE_GEOCODE_URL=https://search.mappls.com/search/address/rev-geocode
# MAPPLS_NEARBY_URL=https://search.mappls.com/search/places/nearby/json
# MAPPLS_ROUTE_URL=https://route.mappls.com/route/direction/route_adv
